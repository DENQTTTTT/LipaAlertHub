{
  "expo": {
    "name": "LipaAlertHub",
    "slug": "lipaalerthub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lipaalerthub",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyB2MdahsHMIyhDjBTTVwgAm1i-zVx4OD5U"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need access to your location to show nearby incidents.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need access to your location to show nearby incidents."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.reden.lipaalerthub",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDHNKCfdb_Ae0sMaSmdDf88xjOvj2hJM68"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "newArchEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow LipaAlertHub to use your location to show nearby incidents.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LipaAlertHub to access your camera to take incident photos."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ],
      "expo-router"
    ]
  }
}