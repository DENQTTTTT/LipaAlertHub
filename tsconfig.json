{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "customConditions": ["react-native"]
  },
  "include": [
    "app",
    "components",
    "constants",
    "hooks",
    "navigation",
    "services",
    "utils",
    "**/*.ts",
    "**/*.tsx"
, "api/email.js"  ],
  "extends": "expo/tsconfig.base"
}
