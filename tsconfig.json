{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "customConditions": ["react-native"],
    "typeRoots": ["./node_modules/@types", "./src/types"]   // ✅ add this
  },
  "include": [
    "src",                        // ✅ ensures all src files + types are included
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "src/types"                   // ✅ explicitly include your custom types
  ],
  "exclude": [
    "node_modules",
    "**/__mocks__/*",
    "**/__tests__/*"
  ]
}
